# Copy this file to targets/k3s/operator.env and fill it locally.
# This file is ignored. Never commit credentials, kubeconfig contents, or raw
# cluster output.

# Context in the operator's own kubeconfig (KUBECONFIG or ~/.kube/config).
# Its cluster server must be a loopback address such as
# https://127.0.0.1:16443; the scripts never copy or write kubeconfig files.
HALLIGALLI_K3S_CONTEXT=k3s-system-admin

# SSH destination for the existing shared Linux host. The operator's SSH agent
# or local SSH configuration supplies authentication; this file holds no key.
HALLIGALLI_K3S_SSH_TARGET=operator@k3s-host

# The API is exposed locally only through this unprivileged SSH-forward port.
HALLIGALLI_K3S_LOCAL_API_PORT=16443

# Read-only K3s data path on the host, used for the preflight disk check.
HALLIGALLI_K3S_REMOTE_DATA_PATH=/var/lib/rancher/k3s

# Comma-separated namespace inventory supplied by the host owner. Do not use
# a guessed value: the preflight refuses to run without an explicit inventory.
HALLIGALLI_K3S_LLM_NAMESPACES=

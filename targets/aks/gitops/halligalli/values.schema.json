{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["webImage", "apiImage", "redisImage", "ingress", "tls"],
  "properties": {
    "webImage": {"$ref": "#/definitions/image"},
    "apiImage": {"$ref": "#/definitions/image"},
    "redisImage": {"$ref": "#/definitions/image"},
    "ingress": {
      "type": "object", "additionalProperties": false,
      "required": ["host", "tlsSecretName"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "tlsSecretName": {"type": "string", "minLength": 1}
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "clusterIssuer", "email"],
      "properties": {
        "enabled": {"type": "boolean"},
        "clusterIssuer": {"type": "string", "minLength": 1},
        "email": {"type": "string", "format": "email", "minLength": 3}
      }
    }
  },
  "definitions": {
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "digest"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    }
  }
}
